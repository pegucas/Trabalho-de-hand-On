<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mente Leve - Câmera / Leitor</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  
  <style>
    /* =========================================
       FUNDO SIMULANDO CÂMERA (PRETO)
       ========================================= */
    body {
      background-color: #000000;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #ffffff;
      margin: 0;
      height: 100vh;
      overflow: hidden; /* Trava a rolagem */
    }

    .app-container {
      max-width: 480px;
      margin: 0 auto;
      height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      background-color: #111; /* Um preto um pouco mais suave */
    }

    /* =========================================
       CABEÇALHO FLUTUANTE SOBRE A CÂMERA
       ========================================= */
    .top-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 10;
      background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);
    }

    .btn-action {
      color: #ffffff;
      font-size: 1.5rem;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      width: 45px;
      height: 45px;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(5px);
      transition: background 0.2s;
    }

    .btn-action:hover {
      background: rgba(255, 255, 255, 0.3);
      color: #ffffff;
    }

    /* =========================================
       ÁREA DA MIRA (VIEWFINDER)
       ========================================= */
    .camera-area {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .viewfinder {
      width: 90%;
      height: 60%;
      border: 2px dashed #00d2ff;
      border-radius: 16px;
      background: rgba(0, 210, 255, 0.05);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
    }

    /* Cantoneiras para dar mais cara de leitor */
    .viewfinder::before, .viewfinder::after {
      content: '';
      position: absolute;
      width: 30px;
      height: 30px;
      border: 4px solid #00d2ff;
    }

    .viewfinder::before {
      top: -2px;
      left: -2px;
      border-right: none;
      border-bottom: none;
      border-top-left-radius: 16px;
    }

    .viewfinder::after {
      bottom: -2px;
      right: -2px;
      border-left: none;
      border-top: none;
      border-bottom-right-radius: 16px;
    }

    .viewfinder i {
      font-size: 3rem;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 15px;
    }

    .viewfinder p {
      color: #ffffff;
      font-weight: 500;
      text-shadow: 1px 1px 3px rgba(0,0,0,0.8);
      padding: 0 20px;
    }

    /* =========================================
       CONTROLES INFERIORES (BOTÃO DE TIRAR FOTO)
       ========================================= */
    .bottom-controls {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      padding: 30px 20px;
      display: flex;
      align-items: center;
      justify-content: space-around;
      background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%);
    }

    .shutter-btn {
      width: 75px;
      height: 75px;
      border-radius: 50%;
      background: #ffffff;
      border: 5px solid rgba(255, 255, 255, 0.3);
      cursor: pointer;
      transition: transform 0.1s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .shutter-btn:active {
      transform: scale(0.95);
      background: #e2e8f0;
    }

    .shutter-inner {
      width: 55px;
      height: 55px;
      border-radius: 50%;
      border: 2px solid #000;
    }

    .btn-gallery {
      color: #ffffff;
      font-size: 1.5rem;
      cursor: pointer;
    }

  </style>
</head>
<body>

  <div class="app-container">
    
    <!-- Cabeçalho (Botão Voltar e Flash) -->
    <header class="top-header">
      <a href="perfil.html" class="btn-action">
        <i class="bi bi-x-lg"></i> <!-- Ícone de fechar em vez de seta, padrão para câmeras -->
      </a>
      <a href="#" class="btn-action">
        <i class="bi bi-lightning-fill"></i>
      </a>
    </header>

    <!-- Área de Foco -->
    <div class="camera-area">
      <div class="viewfinder">
        <i class="bi bi-file-earmark-medical"></i>
        <p>Posicione sua receita médica dentro do quadro</p>
      </div>
    </div>

    <!-- Controles (Botão de tirar foto e galeria) -->
    <div class="bottom-controls">
      <div class="btn-gallery">
        <i class="bi bi-images"></i>
      </div>
      
      <!-- Botão Central de Captura -->
      <a href="perfil.html" class="shutter-btn text-decoration-none">
        <div class="shutter-inner"></div>
      </a>
      
      <div class="btn-gallery" style="opacity: 0;">
        <!-- Espaçador invisível para manter o botão de captura centralizado -->
        <i class="bi bi-images"></i>
      </div>
    </div>

  </div>

</body>
</html>
